{
  "name": "go-usage",
  "version": "0.1.0",
  "description": "OpenCode Desktop plugin that shows OpenCode Go subscription usage (5h, weekly, monthly) in the window footer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clarklooking/opencode-v2-plugin.git",
    "directory": "packages/go-usage"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "desktop",
    "go",
